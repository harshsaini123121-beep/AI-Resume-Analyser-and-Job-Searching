# ==============================================================================
# AI Resume Analyser & Job Matching Platform — Environment Configuration Template
# Copy this file to .env and configure the parameters for your deployment.
# ==============================================================================

# Google Gemini AI API Key (Optional: for AI coaching and career insights)
# Get a free key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

# API Security & Caller Authentication
APP_API_KEY=resumelab_secret_api_key_2026

# FastAPI Server Binding
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

# Rate Limiting (SlowAPI limits)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_UPLOAD=15/minute
RATE_LIMIT_MATCH=30/minute

# Database Connection
# SQLite for local development:
DATABASE_URL=sqlite:///./resume_analyser.db
# PostgreSQL for production Docker:
# DATABASE_URL=postgresql://resumelab:resumelab_secure_pass_2026@postgres:5432/resumelab

# Hybrid Matching Signal Weights (must sum to 1.0)
SKILL_WEIGHT=0.5
SEMANTIC_WEIGHT=0.4
EXPERIENCE_WEIGHT=0.1

# ML Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
ALLOW_TFIDF_FALLBACK=True
